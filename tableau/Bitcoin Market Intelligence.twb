      <column caption='Annualised Vol' datatype='real' default-format='p0%' name='[Calculation_2094736836995952640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='STDEV([Daily Return]) * SQRT(365)' />
      </column>
      <column caption='Latest Date' datatype='date' name='[Calculation_2094736836998107137]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX([Date]) }' />
      </column>
      <column caption='Last Close' datatype='real' name='[Calculation_2094736836998189058]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : MAX(IF [Date] = [Calculation_2094736836998107137] THEN [Close] END) }' />
      </column>
      <column caption='From ATH' datatype='real' name='[Calculation_2094736836998258691]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : MAX(IF [Date] = [Calculation_2094736836998107137] THEN [Drawdown] END) }' />
      </column>
      <column caption='Vol 30D Now' datatype='real' name='[Calculation_2094736836998316036]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : MAX(IF [Date] = [Calculation_2094736836998107137] THEN [Volatility 30D] END) }' />
      </column>
      <column caption='Stress Now' datatype='real' name='[Calculation_2094736836998381573]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : MAX(IF [Date] = [Calculation_2094736836998107137] THEN [P(Stress)] END) }' />
