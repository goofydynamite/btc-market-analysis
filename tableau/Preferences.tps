<?xml version='1.0'?>
<!-- Copy this file to: Documents\My Tableau Public Repository\Preferences.tps  (then restart Tableau Public)
     It adds the project's colour palettes so every chart matches the HTML dashboard. -->
<workbook>
  <preferences>
    <color-palette name="BTC Categorical" type="regular">
      <color>#2a78d6</color>
      <color>#eb6834</color>
      <color>#1baf7a</color>
      <color>#eda100</color>
      <color>#e87ba4</color>
      <color>#008300</color>
      <color>#6250d6</color>
      <color>#e34948</color>
    </color-palette>
    <color-palette name="BTC Regimes" type="regular">
      <color>#9ec5f4</color>
      <color>#2a78d6</color>
      <color>#d03b3b</color>
    </color-palette>
    <color-palette name="BTC Blue Sequential" type="ordered-sequential">
      <color>#cde2fb</color>
      <color>#9ec5f4</color>
      <color>#6da7ec</color>
      <color>#3987e5</color>
      <color>#256abf</color>
      <color>#184f95</color>
      <color>#0d366b</color>
    </color-palette>
    <color-palette name="BTC Loss-Gain Diverging" type="ordered-diverging">
      <color>#b52f2f</color>
      <color>#e34948</color>
      <color>#f0efec</color>
      <color>#3987e5</color>
      <color>#104281</color>
    </color-palette>
  </preferences>
</workbook>
